[
  {
    "type": "function",
    "function": {
      "name": "move_to",
      "description": "Walk to a named spot in the keep.",
      "strict": true,
      "parameters": {
        "type": "object",
        "properties": {
          "spot": {
            "type": "string",
            "enum": [
              "gate",
              "hall",
              "forge",
              "well",
              "tower",
              "cellar"
            ]
          },
          "pace": {
            "type": "string",
            "enum": [
              "sneak",
              "walk",
              "run"
            ]
          }
        },
        "required": [
          "spot",
          "pace"
        ],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "speak",
      "description": "Say one short line to a target.",
      "strict": true,
      "parameters": {
        "type": "object",
        "properties": {
          "target": {
            "type": "string",
            "description": "Entity handle from the scene snapshot."
          },
          "line": {
            "type": "string",
            "maxLength": 120
          },
          "tone": {
            "type": "string",
            "enum": [
              "calm",
              "wary",
              "stern",
              "warm"
            ]
          }
        },
        "required": [
          "target",
          "line",
          "tone"
        ],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "cast_spell",
      "description": "Cast a known spell at a target.",
      "strict": true,
      "parameters": {
        "type": "object",
        "properties": {
          "spell": {
            "type": "string",
            "enum": [
              "spark",
              "salt_ward",
              "mend",
              "hush"
            ]
          },
          "target": {
            "type": "string",
            "description": "Entity handle from the scene snapshot."
          },
          "power": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5,
            "description": "Effort level; higher costs more stamina."
          }
        },
        "required": [
          "spell",
          "target",
          "power"
        ],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
