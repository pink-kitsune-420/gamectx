      "strict": true,
      "parameters": {
        "type": "object",
        "properties": {
          "item": {
            "type": "string",
            "description": "Item id from inventory."
          },
          "target": {
            "type": "string",
            "description": "Entity handle from the scene snapshot."
          },
          "power": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5,
            "description": "Effort level; higher costs more stamina."
          }
        },
        "required": [
          "item",
          "target",
          "power"
        ],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "give_item",
      "description": "Hand a carried item to a target.",
      "strict": true,
      "parameters": {
        "type": "object",
        "properties": {
          "item": {
            "type": "string",
            "description": "Item id from inventory."
          },
          "target": {
            "type": "string",
            "description": "Entity handle from the scene snapshot."
          }
        },
        "required": [
          "item",
          "target"
        ],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "guard",
      "description": "Hold position and watch a target.",
      "strict": true,
      "parameters": {
        "type": "object",
        "properties": {
          "target": {
            "type": "string",
            "description": "Entity handle from the scene snapshot."
          },
          "seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30,
            "description": "Duration in seconds."
          }
        },
        "required": [
          "target",
          "seconds"
        ],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "wait",
      "description": "Do nothing for a while.",
      "strict": true,
      "parameters": {
        "type": "object",
        "properties": {
          "seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30,
